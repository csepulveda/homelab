def interpretar(texto, opciones):
    """Texto libre -> categoría (o None)."""
    t = norm(texto).lower()
    m = re.search(r"\b([1-9])\b", t)
    if m and opciones and int(m.group(1)) <= len(opciones):
        return opciones[int(m.group(1)) - 1]
    if re.fullmatch(r"(ok|si|sí|correcto|dale|bien)\b.*", t) and opciones:
        return opciones[0]
    for c in sorted(ALL_CATS, key=len, reverse=True):
        if c != "Sin categoría" and norm(c).lower() in t:
            return c
    for k, c in SINONIMOS.items():
        if re.search(rf"\b{k}\b", t):
            return c
    desc = "\n".join(f"- {k}: {v}" for k, v in CATS.items()) + "\n- Préstamo: plata que me van a devolver"
    js = llm("El usuario responde qué tipo de gasto fue un movimiento bancario. Mapea su respuesta a UNA categoría:\n"
             + desc + "\nResponde SOLO JSON {\"categoria\": \"<de la lista>\", \"confianza\": <0..1>}. "
             "Si la respuesta no describe un tipo de gasto, {\"categoria\": null, \"confianza\": 0}.", texto)
    c, conf = (js or {}).get("categoria"), (js or {}).get("confianza") or 0
    return c if c in ALL_CATS and c != "Sin categoría" and conf >= 0.7 else None


def aplicar(sh, st, gid, cat, fijo, quien="usuario"):
    row, r = sh.find(gid)
    if not row:
        return f"No encontré {gid} en la planilla."
    p = st.d["pendientes"].pop(gid, None) or {}
    r = r + [""] * (len(GASTOS_COLS) - len(r))
    for g in [gid] + p.get("tambien", []):
        rw, rr = sh.find(g)
        if rw:
            rr = rr + [""] * (len(GASTOS_COLS) - len(rr))
            sh.update(f"Gastos!G{rw}:H{rw}", [[cat, "sí" if fijo else rr[7]]])
            sh.update(f"Gastos!K{rw}", [["confirmado"]])
    tipo = p.get("tipo") or {"T": "Transferencia", "C": "Cartola"}.get(gid[0], "Compra")
    cl = p.get("clave") or r[5]
    msg = f"✓ {gid} → {cat}" + (" (fijo)" if fijo else "")
    if p.get("tambien"):
        msg += f" (y {len(p['tambien'])} movimientos más de {p['contraparte']})"
    if cl and not re.search(GENERICOS, norm(cl)):
        sh.set_regla(tipo, cl, cat, fijo, quien)
        msg += f". Regla guardada para \"{cl.split('|')[0]}\"."
    if st.d.get("ultima_pregunta") == gid:
        st.d["ultima_pregunta"] = None
    st.save()
    return msg


def cmd_responder(args):
    st, sh = State(), Sheet()
    texto = " ".join(args.texto)
    m = re.search(r"\b([GTC]\d{1,5})\b", texto.upper())
    gid = m.group(1) if m else (st.d.get("ultima_pregunta") or next(iter(st.d["pendientes"]), None))
    if not gid:
        print("No tengo preguntas de gastos pendientes.")
        return
    p = st.d["pendientes"].get(gid, {})
    cat = interpretar(re.sub(r"\b[GTC]\d{1,5}\b", "", texto, flags=re.I), p.get("opciones"))
    if not cat:
        print(f"No entendí la categoría para {gid}. Opciones: " + ", ".join(c for c in ALL_CATS if c != "Sin categoría"))
        return
    fijo = bool(re.search(r"\bfijo\b", norm(texto).lower()))
    out = aplicar(sh, st, gid, cat, fijo)
    resto = [g for g in st.d["pendientes"] if g != gid]
    if resto:
        out += f"\nQuedan {len(resto)} pendientes" + (f"; siguiente: {resto[0]}" if len(resto) else "")
    print(out)


def cmd_corregir(args):
    st, sh = State(), Sheet()
    cat = interpretar(" ".join(args.texto), None)
    if not cat:
        print("No entendí la categoría. Opciones: " + ", ".join(c for c in ALL_CATS if c != "Sin categoría"))
        return
    print(aplicar(sh, st, args.id.upper(), cat, bool(re.search(r"\bfijo\b", " ".join(args.texto).lower()))))


def cmd_pendientes(args):
    st = State()
    pend = list(st.d["pendientes"].items())
    if not pend:
        print("NO_REPLY" if args.recordatorio else "No hay gastos pendientes de confirmar. ✨")
        return
    lines = [f"📋 {len(pend)} gastos por confirmar" + (" (resumen del día)" if args.recordatorio else "") + ":"]
    for gid, p in pend[:10]:
        ops = " ".join(f"{i}) {o}" for i, o in enumerate(p.get("opciones") or [p["sugerida"]], 1))
        mas = f" (+{len(p['tambien'])} más)" if p.get("tambien") else ""
        lines.append(f"{gid}: {clp(p.get('monto', 0))} {p['contraparte']} ({p.get('fecha', '')}){mas}\n   {ops}")
    if len(pend) > 10:
        lines.append(f"…y {len(pend) - 10} más.")
    lines.append("Responde por ejemplo \"G12 1\", \"T3 arriendo fijo\" o \"G15 farmacia\" (una por mensaje).")
    st.d["ultima_pregunta"] = pend[0][0]
    st.save()
    print("\n".join(lines))


