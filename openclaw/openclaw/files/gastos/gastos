# --- utilidades ----------------------------------------------------------------

def norm(s):
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode()
    return " ".join(s.upper().split())


def now():
    return dt.datetime.now(TZ).strftime("%d/%m/%Y %H:%M")


def clp(n):
    return "$" + f"{int(n):,}".replace(",", ".")


def num(v):
    return int(re.sub(r"[^\d]", "", str(v)) or 0)


# Descripciones de cartola que no identifican el destino: siempre preguntar, nunca guardar regla.
GENERICOS = r"^(PAGO CUENTAS VIA INTERNET|COMPRA TARJETA DEBITO)$"


def secret(name):
    with open(os.path.join(SECRETS, name)) as f:
        return f.read().strip()


def gog(*args, parse=True, retries=5):
    env = dict(os.environ, GOG_HOME=ENV("GOG_HOME", os.path.expanduser("~/.openclaw/gog")),
               GOG_KEYRING_BACKEND="file", GOG_KEYRING_PASSWORD=secret("GOG_KEYRING_PASSWORD"),
               GOG_ACCOUNT=ACCOUNT)
    cmd = [GOG, "--gmail-no-send", "--enable-commands", "gmail.messages.search,gmail.raw,sheets", *args]
    if parse:
        cmd.append("--json")
    for i in range(retries):
        p = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=120)
        if p.returncode == 0:
            return json.loads(p.stdout) if parse and p.stdout.strip() else p.stdout
        if "rateLimit" in p.stdout + p.stderr or "429" in p.stderr:
            time.sleep(10 * (i + 1))
            continue
        raise RuntimeError(f"gog {' '.join(args[:3])}: {(p.stderr or p.stdout)[-400:]}")
    raise RuntimeError("gog: demasiados reintentos por cuota")


class State:
    """Estado local (fuera del workspace del agente): ids ignorados, preguntas pendientes, contadores."""

    def __init__(self):
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        self.path = os.path.join(STATE_DIR, "state.json")
        try:
            with open(self.path) as f:
                self.d = json.load(f)
        except FileNotFoundError:
            self.d = {}
        self.d.setdefault("ignorados", [])
        self.d.setdefault("pendientes", {})  # id -> {sugerida, opciones, contraparte, tipo, clave, preguntado}
        self.d.setdefault("cartolas", [])
        self.d.setdefault("inicio", dt.date.today().isoformat())
        self.d.setdefault("ultima_pregunta", None)

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.d, f, ensure_ascii=False, indent=1)
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.path)

    @property
    def aprendiendo(self):
        return (dt.date.today() - dt.date.fromisoformat(self.d["inicio"])).days < APRENDIZAJE_DIAS


# --- planilla ------------------------------------------------------------------

class Sheet:
    def __init__(self):
        self._gastos = None

    def rows(self, tab, cols):
        r = gog("sheets", "get", SHEET, f"{tab}!A:{chr(64 + cols)}", "--render", "FORMATTED_VALUE")
        return r.get("values", []) if isinstance(r, dict) else []

    def append(self, tab, rows):
        if rows:
            gog("sheets", "append", SHEET, f"{tab}!A:A", "--values-json", json.dumps(rows, ensure_ascii=False),
                "--insert", "INSERT_ROWS", "--input", "USER_ENTERED")
            self._gastos = None

    def update(self, rng, rows):
        gog("sheets", "update", SHEET, rng, "--values-json", json.dumps(rows, ensure_ascii=False),
            "--input", "USER_ENTERED")
        self._gastos = None

    def gastos(self):
        if self._gastos is None:
            self._gastos = self.rows("Gastos", len(GASTOS_COLS))
        return self._gastos

    def find(self, gid):
        for i, r in enumerate(self.gastos()):
            if r and r[0] == gid:
                return i + 1, r
        return None, None

    def reglas(self):
        out = {}
        for r in self.rows("Reglas", len(REGLAS_COLS))[1:]:
            r = r + [""] * (len(REGLAS_COLS) - len(r))
            if r[1]:
                out[(r[0], norm(r[1]))] = {"cat": r[2], "fijo": r[3].lower() in ("sí", "si", "true", "x"),
                                          "preguntar": r[4].lower() in ("sí", "si", "true", "x")}
        return out

    def set_regla(self, tipo, clave, cat, fijo, origen):
        rows = self.rows("Reglas", len(REGLAS_COLS))
        vals = [tipo, clave, cat, "sí" if fijo else "", "", origen, now()]
        for i, r in enumerate(rows[1:], start=2):
            if len(r) > 1 and r[0] == tipo and norm(r[1]) == norm(clave):
                vals[4] = r[4] if len(r) > 4 else ""
                self.update(f"Reglas!A{i}:G{i}", [vals])
                return
        self.append("Reglas", [vals])

    def ids(self):
        """Generador de IDs por prefijo a partir de lo que ya hay en la planilla (una sola lectura)."""
        last = {}
        for r in self.gastos()[1:]:
            m = re.fullmatch(r"([GTC])(\d+)", r[0]) if r else None
            if m:
                last[m.group(1)] = max(last.get(m.group(1), 0), int(m.group(2)))

        def nxt(prefix):
            last[prefix] = last.get(prefix, 0) + 1
            return f"{prefix}{last[prefix]}"
        return nxt


def cmd_init(_args):
    meta = gog("sheets", "metadata", SHEET)
    tabs = [s["properties"]["title"] for s in meta["sheets"]]
    if "Gastos" not in tabs:
        if tabs == ["Hoja 1"] or tabs == ["Sheet1"]:
            gog("sheets", "rename-tab", SHEET, tabs[0], "Gastos", parse=False)
        else:
            gog("sheets", "add-tab", SHEET, "Gastos", parse=False)
    for t in ("Reglas", "Cartolas"):
        if t not in tabs:
            gog("sheets", "add-tab", SHEET, t, parse=False)
    sh = Sheet()
    for tab, cols in (("Gastos", GASTOS_COLS), ("Reglas", REGLAS_COLS), ("Cartolas", CARTOLAS_COLS)):
        if not sh.rows(tab, len(cols)):
            sh.update(f"{tab}!A1:{chr(64 + len(cols))}1", [cols])
    for rng, typ, pat in (("Gastos!B2:B", "DATE", "dd/mm/yyyy"), ("Gastos!C2:C", "TIME", "hh:mm"),
                          ("Gastos!D2:D", "CURRENCY", "$#,##0"), ("Gastos!O2:O", "DATE_TIME", "dd/mm/yyyy hh:mm"),
                          ("Reglas!G2:G", "DATE_TIME", "dd/mm/yyyy hh:mm"), ("Cartolas!A2:B", "DATE", "dd/mm/yyyy"),
                          ("Cartolas!C2:D", "CURRENCY", "$#,##0"), ("Cartolas!H2:H", "DATE_TIME", "dd/mm/yyyy hh:mm")):
        gog("sheets", "number-format", SHEET, rng, "--type", typ, "--pattern", pat, parse=False)
    for tab in ("Gastos", "Reglas", "Cartolas"):
        gog("sheets", "freeze", SHEET, "--sheet", tab, "--rows", "1", parse=False)
    print("Planilla lista: pestañas Gastos, Reglas y Cartolas.")


# --- categorización --------------------------------------------------------------

def clave(item):
    if item["tipo"] == "transferencia":
        # sin el banco: BCI lo escribe distinto en transferencias normales y programadas
        return f"{item['contraparte']}|{item.get('cuenta4') or ''}"
    return item["contraparte"]


def tipo_regla(item):
    return "Transferencia" if item["tipo"] == "transferencia" else "Compra"


def es_propio(item):
    n = norm(item["contraparte"]).lower()
    return any(o and all(w in n for w in norm(o).lower().split()) for o in OWN_NAMES)


def regla_fija(texto):
    t = norm(texto)
    for rx, cat in FIJAS:
        if re.search(rx, t):
            return cat
    return None


def llm_system():
    desc = "\n".join(f"- {k}: {v}" for k, v in CATS.items())
    propios = " o ".join(f"'{n}'" for n in OWN_NAMES) or "el titular"
    return ("Clasificas movimientos de una cuenta corriente chilena para el control de gastos del titular.\n"
            f"Categorías:\n{desc}\n\n"
            "Reglas:\n"
            "- Los nombres de comercio vienen truncados por el banco (ej. 'HIP LIDER BUENAVE' = Hipermercado Líder Buenaventura).\n"
            "- Prefijos de pasarelas de pago (MERCADOPAGO*, TUU*, SUMUP*, FLOW*, KHIPU) NO indican el rubro: "
            "fíjate en el resto del nombre; si no se puede saber, confianza baja.\n"
            "- 'confianza' es la probabilidad de que la categoría sea correcta. Usa < 0.6 si el nombre es ambiguo, "
            "es una persona, o no conoces el comercio. No inventes.\n"
            f"- Transferencias a {propios} = Traspaso propio.\n"
            "Responde SOLO JSON: {\"categoria\": \"<una de la lista>\", \"confianza\": <0..1>}\n\n"
            "Ejemplos:\n"
            "JUMBO ALTO LAS CO -> {\"categoria\":\"Supermercado\",\"confianza\":0.97}\n"
            "COPEC APP -> {\"categoria\":\"Combustible\",\"confianza\":0.95}\n"
            "MERCADOPAGO*SEKHM -> {\"categoria\":\"Otros\",\"confianza\":0.2}\n"
            "PARKING ALTO LAS -> {\"categoria\":\"Transporte\",\"confianza\":0.9}\n"
            "Transferencia a 'S.PODESTA YUTR' mensaje '' -> {\"categoria\":\"Persona\",\"confianza\":0.4}")


def llm(system, user):
    """Llama a Ollama y devuelve dict o None. El runner MLX no soporta 'format': se valida aquí."""
    body = {"model": MODEL, "stream": False, "think": False, "keep_alive": "30m",
            "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
            "options": {"num_ctx": NUM_CTX, "temperature": 0, "num_predict": 200}}
    for _ in range(2):
        try:
            req = urllib.request.Request(OLLAMA, json.dumps(body).encode(), {"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=120) as r:
                txt = json.load(r)["message"]["content"]
            return json.loads(txt[txt.find("{"): txt.rfind("}") + 1])
        except Exception:  # noqa: BLE001 - Mac dormido, JSON inválido, etc.
            time.sleep(2)
    return None


def sugerir(item):
    if item["tipo"] == "compra":
        user = f"Compra con tarjeta de débito en el comercio: '{item['contraparte']}'"
    elif item["tipo"] == "transferencia":
        user = (f"Transferencia a '{item['contraparte']}' ({item.get('banco') or 's/banco'}), "
                f"mensaje: '{item.get('mensaje') or ''}'")
    else:
        user = f"Cargo en cartola de cuenta corriente: '{item['contraparte']}'"
    js = llm(llm_system(), user) or {}
    cat, conf = js.get("categoria"), js.get("confianza")
    if cat in CATS and isinstance(conf, (int, float)) and 0 <= conf <= 1:
        return cat, float(conf)
    return "Sin categoría", 0.0


def categorizar(item, reglas, st, backfill=False):
    """-> (categoria, fijo, preguntar, motivo)."""
    r = reglas.get((tipo_regla(item), norm(clave(item))))
    if r:
        return r["cat"], r["fijo"], r["preguntar"], "regla"
    if item["tipo"] == "transferencia" and es_propio(item):
        return "Traspaso propio", False, False, "propio"
    fija = regla_fija(f"{item['contraparte']} {item.get('mensaje') or ''}")
    if fija and not re.search(PASARELAS, norm(item["contraparte"])) or fija == "Pago tarjeta":
        return fija, False, False, "fija"
    cat, conf = sugerir(item)
    preguntar = (conf < UMBRAL or (st.aprendiendo and not backfill) or item["tipo"] == "transferencia"
                 or bool(re.search(PASARELAS, norm(item["contraparte"]))))
    return cat, False, preguntar, f"modelo {conf:.2f}"


def pregunta(gid, item, cat):
    ops = [cat] + [c for c in RELACIONADAS.get(cat, ["Otros", "Compras"]) if c != cat][:2]
    if cat == "Sin categoría":
        ops = ["Restaurantes", "Compras", "Supermercado"]
    hora = f" {item['hora']}" if item.get("hora") else ""
    if item["tipo"] == "transferencia":
        head = (f"🤔 {gid}: transferiste {clp(item['monto'])} a {item['contraparte']} "
                f"({item.get('banco') or ''} ****{item.get('cuenta4') or ''}){hora}")
        if item.get("mensaje") and item["mensaje"].lower() != "sin mensaje":
            head += f'\nMensaje: "{item["mensaje"]}"'
    elif item["tipo"] == "compra":
        head = f"🤔 {gid}: {clp(item['monto'])} en {item['contraparte']} ({item['fecha']}{hora})"
    else:
        head = f"🤔 {gid}: cargo {clp(item['monto'])} '{item['contraparte']}' ({item['fecha']})"
    opts = "  ".join(f"{i}) {c}" for i, c in enumerate(ops, 1))
    return head + f"\n{opts}\nResponde el número, otra categoría, o agrega \"fijo\" si es mensual.", ops


# --- sync de correos -------------------------------------------------------------

def search(q, dias, maximo=200):
    ids, page = [], None
    while len(ids) < maximo:
        args = ["gmail", "messages", "search", f"{q} newer_than:{dias}d", "--max", "100"]
        if page:
            args += ["--page", page]
        r = gog(*args)
        ids += [m["id"] for m in r.get("messages") or []]
        page = r.get("nextPageToken")
        if not page:
            break
    return ids


def raw(mid):
    r = gog("gmail", "raw", mid, "--format", "raw")
    return base64.urlsafe_b64decode(r["raw"] + "=" * (-len(r["raw"]) % 4))


def fila(gid, item, cat, fijo, estado, fuente, origen):
    tipo = {"compra": "Compra débito", "transferencia": "Transferencia"}.get(item["tipo"], item["tipo"])
    detalle = item.get("mensaje") or item.get("operacion") or ""
    if item.get("programada"):
        detalle = (detalle + " (programada)").strip()
    cuenta = item.get("tarjeta") or item.get("cuenta4") or ""
    return [gid, item["fecha"], item.get("hora") or "", item["monto"], tipo, item["contraparte"], cat,
            "sí" if fijo else "", detalle, f"****{cuenta}" if cuenta else "", estado, fuente, "", origen, now()]


def cmd_sync(args):
    st, sh = State(), Sheet()
    dias = args.dias or (90 if args.backfill else 3)
    vistos = {r[13] for r in sh.gastos()[1:] if len(r) > 13 and r[13]}
    ign = set(st.d["ignorados"])
    reglas = sh.reglas()
    nxt = sh.ids()
    msgs, rows, cache, nuevos = [], [], {}, 0
    pend_clave = {norm(p["clave"]): g for g, p in st.d["pendientes"].items()}
    for mid in reversed(search(SENDERS, dias)):  # más antiguos primero
        if mid in ign or mid in vistos:
            continue
        p = gp.parse(raw(mid))
        if p["tipo"] in ("ignorar", "copia_destinatario"):
            ign.add(mid)
            continue
        if p["tipo"] == "desconocido":
            ign.add(mid)
            msgs.append(f"⚠️ No reconocí un correo de BCI: \"{p['subject']}\" ({p['from']}). Revisa si es un gasto.")
            continue
        origen = p.get("comprobante") or mid
        if origen in vistos:
            continue
        vistos.add(origen)
        gid = nxt("T" if p["tipo"] == "transferencia" else "G")
        k = (tipo_regla(p), norm(clave(p)))
        if k not in cache:
            cache[k] = categorizar(p, reglas, st, backfill=args.backfill)
        cat, fijo, preguntar, motivo = cache[k]
        if preguntar and args.backfill and p["monto"] < BACKFILL_MIN and norm(clave(p)) not in pend_clave:
            rows.append(fila(gid, p, cat, fijo, "revisar", "correo", origen))
            nuevos += 1
            continue
        rows.append(fila(gid, p, cat, fijo, "pendiente" if preguntar else "auto", "correo", origen))
        nuevos += 1
        if preguntar:
            ya = pend_clave.get(norm(clave(p)))
            if ya:  # misma contraparte ya preguntada: se resolverá junto con esa respuesta
                st.d["pendientes"][ya].setdefault("tambien", []).append(gid)
                continue
            txt, ops = pregunta(gid, p, cat)
            st.d["pendientes"][gid] = {"opciones": ops, "sugerida": cat, "contraparte": p["contraparte"],
                                       "tipo": tipo_regla(p), "clave": clave(p), "preguntado": now(),
                                       "monto": p["monto"], "fecha": p["fecha"], "tambien": []}
            pend_clave[norm(clave(p))] = gid
            if not args.backfill:
                st.d["ultima_pregunta"] = gid
                msgs.append(txt)
        elif not args.backfill and motivo.startswith("modelo"):
            msgs.append(f"✓ {gid}: {clp(p['monto'])} {p['contraparte']} → {cat}")
    for i in range(0, len(rows), 100):
        sh.append("Gastos", rows[i:i + 100])
    st.d["ignorados"] = sorted(ign)[-2000:]
    st.save()
    if args.backfill:
        rev = sum(1 for r in rows if r[10] == "revisar")
        msgs.append(f"📥 Backfill {dias} días: {nuevos} movimientos registrados. "
                    f"{len(st.d['pendientes'])} contrapartes por confirmar (≥ {clp(BACKFILL_MIN)}): escribe \"pendientes\". "
                    f"{rev} de menor monto quedaron como \"revisar\" en la planilla.")
    print("\n\n".join(msgs) if msgs else "NO_REPLY")


