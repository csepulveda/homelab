def _fecha(s):
    """DD/MM/AAAA o número de serie de Sheets (si la celda perdió el formato de fecha)."""
    s = str(s).strip()
    if re.fullmatch(r"\d{5}([.,]\d+)?", s):
        return dt.date(1899, 12, 30) + dt.timedelta(days=int(re.split(r"[.,]", s)[0]))
    return dt.datetime.strptime(s, "%d/%m/%Y").date()


def _limpia(desc):
    d = re.sub(r"^AUT\s+", "", desc)
    return re.sub(r"\s+\d{3,}$", "", d).strip()


def regla_compra(reglas, nombre):
    """El correo trunca el comercio a 16 caracteres y la cartola a ~19: comparar por prefijo."""
    k = norm(nombre)[:16]
    for (tipo, cl), r in reglas.items():
        if tipo == "Compra" and len(cl) >= 8 and (k.startswith(cl[:16]) or cl.startswith(k)):
            return r
    return None


def cmd_cartola(args):
    st, sh = State(), Sheet()
    pwd = secret("BCI_PDF_PASSWORD")
    out = []
    for mid in reversed(search(CARTOLA_Q, args.dias or 45, maximo=12)):
        if mid in st.d["cartolas"]:
            continue
        pdf = gp.cartola_pdf(raw(mid))
        if not pdf:
            continue
        c = gp.parse_cartola(pdf, pwd)
        desde, hasta = c["periodo"]
        if not c["cuadra"]:
            out.append(f"⚠️ Cartola {desde} → {hasta} NO cuadra con su resumen "
                       f"(cargos {clp(c['cargos'])} vs {clp(c['resumen_cargos'] or 0)}). No registré nada; revisar parser.")
            st.d["cartolas"].append(mid)
            continue
        d0, d1 = _fecha(desde.replace("-", "/")), _fecha(hasta.replace("-", "/"))
        # filas de correo dentro del período, por conciliar
        filas = []
        for i, r in enumerate(sh.gastos()[1:], start=2):
            r = r + [""] * (len(GASTOS_COLS) - len(r))
            try:
                f = _fecha(r[1])
            except ValueError:
                continue
            if r[11] == "correo" and not r[12] and d0 <= f <= d1 + dt.timedelta(days=3):
                filas.append({"row": i, "fecha": f, "monto": num(r[3]),
                              "tipo": r[4], "usada": False})
        reglas = sh.reglas()
        nuevas, conciliadas, gasto, ingreso, internos = [], set(), 0, 0, 0
        for mv in c["movimientos"]:
            desc = mv["descripcion"]
            if re.search(INTERNOS, desc):
                internos += 1
                continue
            f = _fecha(mv["fecha"])
            if mv["tipo"] == "cargo":
                es_trf = bool(re.match(r"TRANSFER A|TRASPASO DE FONDOS A TERCERO", desc))
                cand = [x for x in filas if not x["usada"] and x["monto"] == mv["monto"]
                        and abs((x["fecha"] - f).days) <= 3
                        and (x["tipo"] == "Transferencia") == es_trf]
                if cand:
                    best = min(cand, key=lambda x: abs((x["fecha"] - f).days))
                    best["usada"] = True
                    conciliadas.add(best["row"])
                    continue
            item = {"tipo": "cartola", "contraparte": _limpia(desc), "monto": mv["monto"], "fecha": mv["fecha"]}
            if mv["tipo"] == "abono":
                cat, preguntar = ("Traspaso propio" if es_propio({"contraparte": desc}) else "Ingreso"), False
            elif re.match(r"TRANSFER A ", desc) and es_propio({"contraparte": desc[11:]}):
                cat, preguntar = "Traspaso propio", False
            else:
                r = reglas.get(("Cartola", norm(item["contraparte"]))) or regla_compra(reglas, item["contraparte"])
                if re.search(GENERICOS, norm(item["contraparte"])):
                    cat, preguntar = "Sin categoría", True
                elif r:
                    cat, preguntar = r["cat"], r["preguntar"]
                else:
                    cat = regla_fija(desc) or sugerir(item)[0]
                    preguntar = not regla_fija(desc)
            nuevas.append((item, mv, cat, preguntar))
        filas_out, n_preg, nxt = [], 0, sh.ids()
        pend_clave = {p["clave"]: g for g, p in st.d["pendientes"].items()}
        for item, mv, cat, preguntar in nuevas:
            gid = nxt("C")
            tipo = "Ingreso" if mv["tipo"] == "abono" else "Cargo cartola"
            generico = bool(re.search(GENERICOS, norm(item["contraparte"])))
            estado = "pendiente" if preguntar else "auto"
            if preguntar and args.backfill and mv["monto"] < BACKFILL_MIN:
                estado = "revisar"
            filas_out.append([gid, mv["fecha"], "", mv["monto"], tipo, item["contraparte"], cat, "", mv["descripcion"],
                              "", estado, "cartola", "✅", f"cartola:{desde}", now()])
            if estado == "pendiente":
                ya = pend_clave.get(item["contraparte"]) if not generico else None
                if ya:
                    st.d["pendientes"][ya].setdefault("tambien", []).append(gid)
                    continue
                pend_clave[item["contraparte"]] = gid
                n_preg += 1
                st.d["pendientes"][gid] = {"opciones": [cat] + RELACIONADAS.get(cat, ["Otros", "Compras"])[:2],
                                           "sugerida": cat, "contraparte": item["contraparte"], "tipo": "Cartola",
                                           "clave": item["contraparte"], "preguntado": now(),
                                           "monto": mv["monto"], "fecha": mv["fecha"], "tambien": []}
            if mv["tipo"] == "abono":
                ingreso += mv["monto"] if cat == "Ingreso" else 0
        sh.append("Gastos", filas_out)
        for row in conciliadas:
            sh.update(f"Gastos!M{row}", [["✅"]])
        # lo de los últimos 3 días del período puede contabilizarse en la cartola siguiente
        sin = [x["row"] for x in filas if not x["usada"] and x["fecha"] <= d1 - dt.timedelta(days=3)]
        for row in sin:
            sh.update(f"Gastos!M{row}", [["⚠️ no está en cartola"]])
        # gasto real del período: filas de la planilla (correo + cartola) que no son NO_GASTO
        sh._gastos = None
        for r in sh.gastos()[1:]:
            r = r + [""] * (len(GASTOS_COLS) - len(r))
            try:
                f = _fecha(r[1])
            except ValueError:
                continue
            if d0 <= f <= d1 and r[4] != "Ingreso" and r[6] not in NO_GASTO:
                gasto += num(r[3])
        sh.append("Cartolas", [[desde.replace("-", "/"), hasta.replace("-", "/"), c["cargos"], c["abonos"],
                                "sí", len(c["movimientos"]), len(nuevas), now()]])
        st.d["cartolas"].append(mid)
        st.save()
        out.append(f"📊 Cartola {desde} → {hasta}: cuadra ✅\n"
                   f"Gasto real: {clp(gasto)} · Ingresos: {clp(ingreso)}\n"
                   f"{len(conciliadas)} conciliados · {len(nuevas)} agregados sin aviso · "
                   f"{len(sin)} sin cartola · {internos} internos (línea de sobregiro)"
                   + (f"\n{n_preg} por confirmar: escribe \"pendientes\"." if n_preg else ""))
    print("\n\n".join(out) if out else "NO_REPLY")


